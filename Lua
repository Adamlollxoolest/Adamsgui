-- Logic: Smart Monster ESP (Ignores shop dummies, stands, and non-moving entities)
local espEnabled = false
local activeHighlights = {}

local function clearHighlights()
	local index = 1
	while index <= #activeHighlights do
		local highlight = activeHighlights[index]
		if highlight then
			highlight:Destroy()
		end
		index = index + 1
	end
	activeHighlights = {}
end

local function isMonster(model)
	local name = model.Name:lower()
	local parentName = model.Parent and model.Parent.Name:lower() or ""
	
	-- Blacklist names that indicate shop displays, dummies, or clothing stands
	local blacklist = {"shop", "merchant", "npc", "dummy", "train", "guide", "citizen", "seller", "dealer", "quest", "baker", "starter", "buy", "item", "weapon", "chest", "crate", "display", "mannequin", "shirt", "stand"}
	for _, term in ipairs(blacklist) do
		if name:find(term) or parentName:find(term) then
			return false
		end
	end
	
	local hum = model:FindFirstChildOfClass("Humanoid")
	local rootPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Torso")
	
	if not hum or not rootPart then return false end
	if players:GetPlayerFromCharacter(model) then return false end
	if hum.Health <= 0 then return false end
	
	-- Ignore anchored models (dummies/shop owners usually don't move or are anchored)
	if rootPart.Anchored then return false end
	
	return true
end

local function updateESP()
	if not espEnabled then
		clearHighlights()
		return
	end
	
	local descendants = workspace:GetDescendants()
	local dIndex = 1
	while dIndex <= #descendants do
		local obj = descendants[dIndex]
		if obj:IsA("Model") and obj ~= player.Character then
			if isMonster(obj) then
				if not obj:FindFirstChild("MonsterHighlight") then
					local highlight = Instance.new("Highlight")
					highlight.Name = "MonsterHighlight"
					highlight.Adornee = obj
					highlight.FillColor = Color3.fromRGB(255, 50, 50)
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.FillTransparency = 0.5
					highlight.OutlineTransparency = 0
					highlight.Parent = obj
					table.insert(activeHighlights, highlight)
				end
			else
				local existing = obj:FindFirstChild("MonsterHighlight")
				if existing then
					existing:Destroy()
				end
			end
		end
		dIndex = dIndex + 1
	end
end

espBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	if espEnabled then
		espBtn.Text = "Monster ESP: ON"
		espBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
	else
		espBtn.Text = "Monster ESP: OFF"
		espBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
		clearHighlights()
	end
end)

runService.Heartbeat:Connect(function()
	if espEnabled then
		updateESP()
	end
end)

