-- Logic: Apply stats
local function applyStats()
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			local newSpeed = tonumber(speedBox.Text)
			local newJump = tonumber(jumpBox.Text)
			if newSpeed then hum.WalkSpeed = newSpeed end
			if newJump then hum.JumpPower = newJump end
		end
	end
end

applyBtn.MouseButton1Click:Connect(applyStats)

