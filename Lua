-- Movement Check
local function isPlayerWalking()
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.MoveDirection.Magnitude > 0 then
			return true
		end
	end
	return false
end

-- Universal Movement-Lock Dragging System
local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

frame.InputBegan:Connect(function(input)
	if isPlayerWalking() then return end
	if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
		dragging = true
		dragInput = input
		dragStart = input.Position
		startPos = frame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				if input == dragInput then
					dragging = false
					dragInput = nil
				end
			end
		end)
	end
end)

userInputService.InputChanged:Connect(function(input)
	if isPlayerWalking() then
		dragging = false
		dragInput = nil
		return
	end
	
	if dragging and input == dragInput and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
