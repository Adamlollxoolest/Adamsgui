local originalShadows = lighting.GlobalShadows
local originalFogEnd = lighting.FogEnd
local originalFogStart = lighting.FogStart
local originalBrightness = lighting.Brightness
local originalAmbient = lighting.Ambient
local originalOutdoorAmbient = lighting.OutdoorAmbient
local removedTriggers = {}
local removedAtmosphere = nil
local removedPostEffects = {}

fogBtn.MouseButton1Click:Connect(function()
	fogEnabled = not fogEnabled
	local targetColor = fogEnabled and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(70, 70, 70)
	tweenService:Create(fogBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
	
	if fogEnabled then
		fogBtn.Text = "Remove Fog: ON"
		
		originalShadows = lighting.GlobalShadows
		originalFogEnd = lighting.FogEnd
		originalFogStart = lighting.FogStart
		originalBrightness = lighting.Brightness
		originalAmbient = lighting.Ambient
		originalOutdoorAmbient = lighting.OutdoorAmbient
		
		lighting.GlobalShadows = false
		lighting.Brightness = 3
		lighting.Ambient = Color3.fromRGB(255, 255, 255)
		lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
		lighting.FogEnd = 100000
		lighting.FogStart = 0
		
		local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere then
			removedAtmosphere = atmosphere
			atmosphere.Parent = nil
		end
		
		removedPostEffects = {}
		for _, child in ipairs(lighting:GetChildren()) do
			if child:IsA("PostEffect") then
				table.insert(removedPostEffects, {item = child, parent = child.Parent})
				child.Parent = nil
			end
		end
		
		removedTriggers = {}
		for _, obj in ipairs(workspace:GetDescendants()) do
			local name = obj.Name:lower()
			if name:find("fog") or name:find("blind") or name:find("darkness") or name:find("hazard") or name:find("jumpparent") then
				if obj:IsA("BasePart") then
					table.insert(removedTriggers, {item = obj, parent = obj.Parent})
					obj.Parent = nil
				elseif obj:IsA("Script") or obj:IsA("LocalScript") then
					table.insert(removedTriggers, {item = obj, parent = obj.Parent})
					obj.Disabled = true
				end
			end
		end
	else
		fogBtn.Text = "Remove Fog: OFF"
		
		lighting.GlobalShadows = originalShadows
		lighting.Brightness = originalBrightness
		lighting.Ambient = originalAmbient
		lighting.OutdoorAmbient = originalOutdoorAmbient
		lighting.FogEnd = originalFogEnd
		lighting.FogStart = originalFogStart
		
		if removedAtmosphere then
			removedAtmosphere.Parent = lighting
			removedAtmosphere = nil
		end
		
		for _, data in ipairs(removedPostEffects) do
			if data.item and data.parent then data.item.Parent = data.parent end
		end
		removedPostEffects = {}
		
		for _, data in ipairs(removedTriggers) do
			if data.item and data.parent then
				if data.item:IsA("BasePart") then
					data.item.Parent = data.parent
				elseif data.item:IsA("Script") or data.item:IsA("LocalScript") then
					data.item.Disabled = false
				end
			end
		end
		removedTriggers = {}
	end
end)

