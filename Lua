-- Logic: Strict Monster ESP (Filters out NPCs, Shop Keepers, Dummies, and Safe Entities)
local espEnabled = false
local activeHighlights = {}

local function clearHighlights()
	for _, highlight in pairs(activeHighlights) do
		if highlight then
			highlight:Destroy()
		end
	end
	activeHighlights = {}
end

local function isMonster(model)
	local name = model.Name:lower()
	
	local blacklist = {"shop", "merchant", "npc", "dummy", "train", "guide", "citizen", "seller", "dealer", "quest", "baker", "safe", "starter"}
	for _, term in ipairs(blacklist) do
		if name:find(term) then
			return false
		end
	end
	
	local hum = model:FindFirstChildOfClass("Humanoid")
	local rootPart = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
	
	if not hum or not rootPart then return false end
	if players:GetPlayerFromCharacter(model) then return false end
	if hum.Health <= 0 then return false end
	
	if hum.WalkSpeed <= 0 and hum.MoveDirection.Magnitude == 0 then
		return false
	end
	
	return true
end

local function updateESP()
	if not espEnabled then
		clearHighlights()
		return
	end
	
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj ~= player.Character then
			if isMonster(obj) then
				if not obj:FindFirstChild("MonsterHighlight") then
					local highlight = Instance.new("Highlight")
					highlight.Name = "MonsterHighlight"
					highlight.Adornee = obj
					highlight.FillColor = Color3.fromRGB(255, 50, 50)
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.FillTransparency = 0.5
					highlight.OutlineTransparency = 0
					highlight.Parent = obj
					table.insert(activeHighlights, highlight)
				end
			else
				local existing = obj:FindFirstChild("MonsterHighlight")
				if existing then
					existing:Destroy()
				end
			end
		end
	end
end

