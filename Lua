local function getButtonBaseColor(btn)
	if btn == noclipBtn then return noclipEnabled and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(70, 70, 70)
	elseif btn == espBtn then return espEnabled and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(70, 70, 70)
	elseif btn == fogBtn then return fogEnabled and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(70, 70, 70)
	elseif btn == lockBtn then return guiLocked and Color3.fromRGB(220, 180, 0) or Color3.fromRGB(70, 70, 70)
	elseif btn == applyBtn then return Color3.fromRGB(0, 150, 255)
	elseif btn == resetBtn then return Color3.fromRGB(180, 50, 50)
	end
	return Color3.fromRGB(70, 70, 70)
end

local function setupShrinkEffect(button)
	local origSize = button.Size
	local origPos = button.Position
	
	local shrinkSize = UDim2.new(origSize.X.Scale, origSize.X.Offset - 4, origSize.Y.Scale, origSize.Y.Offset - 3)
	local shrinkPos = UDim2.new(origPos.X.Scale, origPos.X.Offset + 2, origPos.Y.Scale, origPos.Y.Offset + 1.5)
	
	button.MouseEnter:Connect(function()
		if activePressedButton and activePressedButton ~= button then
			local prevBase = getButtonBaseColor(activePressedButton)
			tweenService:Create(activePressedButton, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = prevBase}):Play()
		end
		
		activePressedButton = button
		tweenService:Create(button, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = shrinkSize,
			Position = shrinkPos,
			BackgroundColor3 = button.BackgroundColor3:Lerp(Color3.fromRGB(255, 255, 255), 0.35)
		}):Play()
	end)
	
	button.MouseLeave:Connect(function()
		local baseCol = getButtonBaseColor(button)
		tweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = origSize,
			Position = origPos,
			BackgroundColor3 = baseCol
		}):Play()
	end)
	
	button.MouseButton1Down:Connect(function()
		activePressedButton = button
		tweenService:Create(button, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = shrinkSize,
			Position = shrinkPos,
			BackgroundColor3 = button.BackgroundColor3:Lerp(Color3.fromRGB(255, 255, 255), 0.45)
		}):Play()
	end)
end

